model AICreditLedgerEntry {
  id           String   @id @default(uuid())
  college_id   String
  campus_id    String?
  bucket       String   // PLAN, PURCHASED
  periodKey    String?  // YYYY-MM for PLAN, null for PURCHASED
  delta        Int
  type         String   // MONTHLY_GRANT, PURCHASE, TASK_DEBIT
  balanceAfter Int
  taskType     String?
  createdAt    DateTime @default(now())
  college      College  @relation(fields: [college_id], references: [id], onDelete: Cascade)

