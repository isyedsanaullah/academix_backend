datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model AdmissionSeason {
  id                String    @id @default(uuid())
  college_id        String
  session_id        String
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  availableGroups   String[]
  availableClasses  String[]
  entryTestRequired Boolean?  @default(false)
  entryTestDate     DateTime?
  entryTestVenue    String?
  minAggregate      Float?
  maxSeats          Int?
  status            String?   @default("draft") // draft, open, closed, completed
  instructions      String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([college_id, status])
}

model AIApiKey {
  id           String    @id @default(uuid())
  userId       String
  collegeId    String?
  provider     String    @default("gemini")
  encryptedKey String
  iv           String
  isActive     Boolean?  @default(true)
  lastUsed     DateTime?
  usageCount   Int?      @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([collegeId])
}

model AIUsageLog {
  id           String   @id @default(uuid())
  userId       String
  collegeId    String?
  action       String
  model        String?
  tokensUsed   Int?     @default(0)
  duration     Float?
  success      Boolean? @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([collegeId, action])
  @@index([createdAt(sort: Desc)])
}

model Announcement {
  id            String    @id @default(uuid())
  college_id    String
  title         String
  content       String
  category      String? // Emergency, Holiday, Academic, Examination, Fee, Admission, Event, Administration, General
  audience      String? // All Users, All Students, All Teachers, Parents, Staff, Faculty, Specific Department, Specific Class
  isPublic      Boolean?  @default(false)
  priority      String? // Low, Medium, High, Urgent
  status        String?   @default("Published") // Published, Draft, Scheduled, Archived
  scheduledFor  DateTime?
  expiresAt     DateTime?
  generatedByAI Boolean?  @default(false)
  templateType  String? // Emergency, Examination, Fee, Holiday, Event, General...
  viewCount     Int       @default(0)
  attachments   String[]
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deletedAt         DateTime?
  deletedBy         String?
  deleteReason      String?
  deleteOperationId String?

  @@index([college_id, createdAt(sort: Desc)])
  @@index([college_id, audience])
  @@index([college_id, status])
  @@index([college_id, scheduledFor])
  @@index([college_id, deletedAt])
  @@index([deleteOperationId])
}

model Application {
  id                String    @id @default(uuid())
  college_id        String
  season_id         String
  user_id           String?
  applicationNumber String?   @unique
  name              String
  fatherName        String
  cnic              String?
  dateOfBirth       DateTime
  gender            String
  phone             String
  email             String
  address           String
  city              String?
  guardianName      String?
  guardianPhone     String?
  guardianRelation  String?
  sscBoard          String
  sscYear           Int
  sscRollNumber     String?
  sscTotalMarks     Float
  sscObtainedMarks  Float
  sscAggregate      Float?
  sscResultStatus   String? // declared, awaiting
  preferredClass    String? // FSC Part 1, FSC Part 2
  preferredGroup    String
  photo             String?
  sscDMC            String?
  hopeCertificate   String?
  ninthDMC          String?
  otherDocuments    Json?
  entryTestRequired Boolean?  @default(false)
  entryTestDate     DateTime?
  entryTestVenue    String?
  entryTestScore    Float?
  entryTestStatus   String?   @default("pending") // pending, scheduled, appeared, passed, failed
  status            String?   @default("submitted") // submitted, under_review, entry_test, approved, rejected, enrolled
  rejectionReason   String?
  reviewedBy        String?
  reviewedAt        DateTime?
  remarks           String?
  source            String?   @default("ONLINE") // ONLINE, DESK
  enteredBy         String?
  quota             String?                      // QuotaRule.code
  equivalenceBoard  String?                      // O-level, A-level, other board
  equivalenceMarks  Float?                       // IBCC equivalence percent
  docVerification   Json?                        // { sscDMC: { ok:true, by, at }, cnic: {...}, photo: {...} }
  scholarshipTier_id String?
  meritScore        Float?
  password          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([college_id, season_id, status])
  @@index([college_id, email])
  @@index([applicationNumber])
}

model Approval {
  id                String    @id @default(uuid())
  college_id        String
  type              String
  status            String?   @default("pending") // pending, approved, rejected
  requestedBy       String
  data              Json
  relatedModel      String?
  relatedId         String?
  title             String
  description       String?
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  requiredApprovals Int?      @default(1)
  approvers         Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([college_id, status, type])
  @@index([college_id, createdAt(sort: Desc)])
}

model Assignment {
  id             String   @id @default(uuid())
  college_id     String
  session_id     String
  class_id       String
  section_id     String?
  subject_id     String
  teacher_id     String
  title          String
  description    String?
  instructions   String?
  dueDate        DateTime
  totalMarks     Float?
  submissionType String? // handwritten, typed, both
  attachments    Json?
  submissions    Json?
  status         String?  @default("active") // active, closed, draft
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deletedAt         DateTime?
  deletedBy         String?
  deleteReason      String?
  deleteOperationId String?

  @@index([college_id, session_id, class_id])
  @@index([college_id, teacher_id])
  @@index([college_id, deletedAt])
  @@index([deleteOperationId])
}

model Attendance {
  id         String    @id @default(uuid())
  college_id String
  session_id String
  student_id String
  class      String?
  section    String?
  date       DateTime
  status     String // present, absent, late, leave
  method     String?   @default("manual") // biometric, face, card, qr, manual
  entryTime  DateTime?
  exitTime   DateTime?
  markedBy   String?
  remarks           String?
  correctionReason  String?
  createdAt         DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([college_id, session_id, student_id, date])
  @@index([college_id, session_id, date])
  @@index([college_id, session_id, class, section, date])
}

model AuditLog {
  id         String   @id @default(uuid())
  college_id String?
  user_id    String
  action     String
  resource   String?
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([college_id, createdAt(sort: Desc)])
  @@index([user_id, createdAt(sort: Desc)])
  @@index([action])
}

model StatusOperationLog {
  id             String    @id @default(uuid())
  operationId    String    @unique @default(uuid())
  resourceType   String    // College, Student, User, Class
  resourceId     String
  actorUserId    String
  previousStatus String
  newStatus      String
  college_id     String?   // For tenant scoping
  createdAt      DateTime  @default(now())
  expiresAt      DateTime  // createdAt + 5 seconds (undo window)
  undoneAt       DateTime? // Timestamp when reverted, null if still active

  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([operationId])
  @@index([college_id])
}

model ActivityLog {
  id                 String   @id @default(uuid())
  college_id         String?
  actorUserId        String?
  actorNameSnapshot  String?
  actorRoleSnapshot  String?
  action             String
  category           String
  resourceType       String?
  resourceId         String?
  targetUserId       String?
  title              String?
  description        String?
  status             String?  @default("completed")
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([college_id, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([category])
  @@index([action])
  @@index([resourceType, resourceId])
}


model CanteenTransaction {
  id            String   @id @default(uuid())
  college_id    String
  student_id    String
  items         Json?
  totalAmount   Float
  paymentMethod String? // cash, account, card
  enteredBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([college_id, student_id])
  @@index([college_id, createdAt(sort: Desc)])
}

model Certificate {
  id                   String    @id @default(uuid())
  college_id           String
  student_id           String
  type                 String // character, hope, migration, bonafide
  certificateNumber    String    @unique
  verifyToken          String?   @unique
  templateVersion      Int?      @default(1)
  issueDate            DateTime?
  content              String?
  predictedPerformance String?
  academicConsistency  String?
  basedOn              Json?
  issuedBy             String?
  status               String?   @default("issued") // issued, revoked
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([college_id, student_id])
  @@index([college_id, type])
}

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  collegeId String?
  role      String // student, teacher, principal, admin, registrar, accountant, employee
  title     String?
  messages  Json?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@index([collegeId])
}

model Class {
  id         String   @id @default(uuid())
  college_id String
  session_id String
  name       String // FSC Part 1, FSC Part 2
  groups     String[]
  isActive   Boolean? @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([college_id, session_id, name])
}

model Group {
  id         String   @id @default(uuid())
  college_id String
  class_id   String // References Class.id (Part)
  name       String // e.g. "Computer Science", "Pre-Medical"
  seats      Int?
  feeNote    String?
  isActive   Boolean? @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([college_id, class_id, name])
}

model College {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  slug             String?  @unique
  mongoUrl         String?  @default("")
  email            String   @unique
  phone            String?
  address          String?
  city             String?
  logo             String?  @default("")
  website          String?  @default("")
  subscription     Json?
  settings         Json?
  onboardingStatus String?  @default("completed") // pending_invite, registered, in_progress, completed
  onboardingStep   Int?     @default(1)
  totalStudents    Int?     @default(0)
  totalStaff       Int?     @default(0)
  isActive         Boolean? @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([subscription(path: "status")])
}

model CollegeInvitation {
  id         String    @id @default(uuid())
  email      String
  planId     String
  token      String    @unique
  status     String    @default("pending") // pending, accepted, expired, cancelled
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  collegeId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([token])
}


model EarlyExitRequest {
  id              String    @id @default(uuid())
  college_id      String
  personType      String // student, teacher, employee
  personId        String
  personName      String?
  qrCode          String?
  reason          String
  exitDate        DateTime
  exitTime        String?
  status          String?   @default("pending") // pending, approved, rejected
  approvedBy      String?
  approvedAt      DateTime?
  approvalRemarks String?
  used            Boolean?  @default(false)
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([college_id, personId, exitDate])
  @@index([college_id, status])
}

model Employee {
  id            String    @id @default(uuid())
  college_id    String
  user_id       String    @unique
  employeeCode  String?
  cnic          String?
  phone         String?
  address       String?
  department    String? // security, canteen, administration, accounts, library, lab, other
  designation   String?
  joiningDate   DateTime?
  salary        Float?
  salaryHistory Json?
  leaveBalance  Json?
  leaveRecords  Json?
  status        String?   @default("active") // active, on-leave, resigned, terminated
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([college_id, department])
}

model EvaluationSeason {
  id          String   @id @default(uuid())
  college_id  String
  title       String
  startDate   DateTime
  endDate     DateTime
  status      String?  @default("announced") // announced, active, completed, cancelled
  announcedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([college_id, status])
}

model Evaluation {
  id          String    @id @default(uuid())
  college_id  String
  season_id   String
  student_id  String
  teacher_id  String
  questions   Json?
  goodCount   Int?      @default(0)
  stars       Float?    @default(0)
  completed   Boolean?  @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([college_id, season_id, student_id, teacher_id])
  @@index([college_id, teacher_id])
}

model Exam {
  id           String   @id @default(uuid())
  college_id   String
  session_id   String
  name         String
  type         String // mid, final, test, practical, send_up
  class        String // FSC Part 1, FSC Part 2, Both
  group        String? // Pre-Medical, Pre-Engineering, Computer Science, all
  section      String?
  subjects     Json?
  seatingPlan  Json?
  invigilation Json?
  status       String?  @default("scheduled") // scheduled, ongoing, completed, cancelled
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([college_id, session_id, class])
  @@index([college_id, session_id, status])
}

model Fee {
  id                   String    @id @default(uuid())
  college_id           String
  session_id           String
  student_id           String
  title                String?
  type                 String?   @default("monthly") // yearly, installment, monthly
  month                String
  tuitionFee           Decimal?  @default(0) @db.Decimal(12, 2)
  functionFee          Decimal?  @default(0) @db.Decimal(12, 2)
  labFee               Decimal?  @default(0) @db.Decimal(12, 2)
  fine                 Decimal?  @default(0) @db.Decimal(12, 2)
  scholarshipDeduction Decimal?  @default(0) @db.Decimal(12, 2)
  canteenDues          Decimal?  @default(0) @db.Decimal(12, 2)
  otherCharges         Decimal?  @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal   @db.Decimal(12, 2)
  paidAmount           Decimal?  @default(0) @db.Decimal(12, 2)
  status               String?   @default("unpaid") // paid, partial, unpaid, overdue
  paidDate             DateTime?
  receiptNumber        String?
  challanNumber        String?
  verifyToken          String?   @unique
  dueDate              DateTime?
  enteredBy            String?
  remarks              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([college_id, session_id, student_id, month])
  @@index([college_id, session_id, status])
}

model Fine {
  id         String    @id @default(uuid())
  college_id String
  session_id String
  student_id String
  teacher_id String
  amount     Float
  reason     String
  category   String? // discipline, late, uniform, damage, cheating, other
  status     String?   @default("unpaid") // unpaid, paid
  paidDate   DateTime?
  addedToFee String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([college_id, session_id, student_id])
  @@index([college_id, teacher_id])
  @@index([college_id, status])
}

model GateLog {
  id                 String    @id @default(uuid())
  college_id         String
  personType         String // student, teacher, employee
  personId           String
  personModel        String // Student, Teacher, User
  personName         String?
  personRole         String?
  qrCode             String?
  action             String // entry, exit
  timestamp          DateTime?
  date               DateTime
  isEarlyExit        Boolean?  @default(false)
  earlyExitApproved  Boolean?  @default(false)
  earlyExitRequestId String?
  scannedBy          String?
  remarks            String?
  
  // New Fields
  verificationMethod String    @default("QR") // "QR", "FINGERPRINT", etc.
  deviceId           String?
  location           String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([college_id, date, personId])
  @@index([college_id, personId, action])
  @@index([college_id, date, action])
}

model LeaveApplication {
  id            String    @id @default(uuid())
  college_id    String
  session_id    String
  student_id    String
  user_id       String
  leaveDate     DateTime
  leaveDateEnd  DateTime?
  reason        String
  category      String? // medical, family, personal, emergency, other
  attachmentUrl String?
  status        String?   @default("pending") // pending, approved, rejected
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewRemarks String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([college_id, session_id, student_id, leaveDate])
  @@index([college_id, status])
  @@index([college_id, session_id, status, createdAt(sort: Desc)])
}

model Notification {
  id         String    @id @default(uuid())
  college_id String
  recipient  String
  title      String
  message    String
  type       String? // result, fee, attendance, announcement, assignment, quiz, system, general
  link       String?
  isRead     Boolean?  @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([college_id, recipient, isRead])
  @@index([createdAt(sort: Desc)])
}

model Payment {
  id              String   @id @default(uuid())
  college_id      String
  fee_id          String
  student_id      String
  idempotencyKey  String?  @unique
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String?  // cash, bank, online, cheque, easypaisa, jazzcash, raast
  receiptNumber   String   @unique
  referenceNumber String?
  verifyToken     String?  @unique
  receivedBy      String?
  verifiedBy      String?
  signedBy        String?
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([college_id, student_id])
  @@index([college_id, fee_id])
  @@index([receiptNumber])
}

model PaymentProof {                   // student uploads an EasyPaisa / JazzCash / bank screenshot for a voucher
  id            String    @id @default(uuid())
  college_id    String
  student_id    String
  fee_id        String
  method        String                 // easypaisa, jazzcash, bank, raast, other
  amount        Decimal   @db.Decimal(12, 2)
  transactionId String                 // typed by the student; unique per college so one payment cannot pay two vouchers
  senderName    String?
  senderPhone   String?
  paidOn        DateTime?
  file_id       String                 // StoredFile.id of the screenshot (compressed)
  status        String?   @default("pending") // pending, verified, rejected, duplicate
  rejectReason  String?
  verifiedBy    String?
  verifiedAt    DateTime?
  payment_id    String?                // Payment.id created on verification
  ocrData       Json?                  // filled only by ai-payment-ocr
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([college_id, transactionId])
  @@index([college_id, status, createdAt(sort: Desc)])
  @@index([college_id, student_id])
}

model TimetableSubstitution {          // one row per period handed to a substitute, never the whole day to one person
  id                   String   @id @default(uuid())
  college_id           String
  session_id           String?
  date                 DateTime
  slotKey              String             // the timetable period identifier used by the existing timetable (section + day + period)
  section_id           String?
  class                String?
  section              String?
  periodNumber         Int?
  subject_id           String?
  absentTeacher_id     String
  substituteTeacher_id String
  reason               String?            // leave, sick, official duty, other
  status               String?  @default("assigned") // assigned, done, cancelled
  assignedBy           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([college_id, date, slotKey])
  @@index([college_id, date, substituteTeacher_id])
  @@index([college_id, date, absentTeacher_id])
}

model TeacherSubject {                 // a teacher can teach several subjects in several classes and groups
  id               String   @id @default(uuid())
  college_id       String
  teacher_id       String
  subject_id       String
  class            String?                  // FSC Part 1, FSC Part 2, Both
  group            String?
  isPrimary        Boolean? @default(false)
  maxPeriodsPerDay Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([college_id, teacher_id, subject_id, class, group])
  @@index([college_id, teacher_id])
  @@index([college_id, subject_id])
}

model TimetableConstraint {            // input for the generator: rooms, teacher availability, subject load
  id         String   @id @default(uuid())
  college_id String
  session_id String?
  kind       String                    // teacher_unavailable, room, subject_load, no_double_period, fixed_slot
  teacher_id String?
  subject_id String?
  section_id String?
  data       Json                      // { day, period, room, periodsPerWeek ... }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([college_id, session_id, kind])
}

model TimetableDraft {                 // generated draft before applying to live timetable
  id               String   @id @default(uuid())
  college_id       String
  session_id       String?
  name             String?  @default("Draft Timetable")
  hardScore        Int      @default(0)   // 0 = no hard violations
  softScore        Int      @default(0)
  unplacedPeriods  Json?    // array of unplaced period requests with reasons
  clashes          Json?    // list of clashes or hard violations if any
  grid             Json     // the generated periods grouped by section/day
  options          Json?    // generation options (periodsPerDay, days, etc.)
  status           String?  @default("draft") // draft, applied, discarded
  appliedAt        DateTime?
  appliedBy        String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([college_id, session_id, status])
}

model PlatformInvoice {
  id            String    @id @default(uuid())
  college_id    String
  invoiceNo     String    @unique
  planId        String?
  periodStart   DateTime
  periodEnd     DateTime
  amount        Decimal   @db.Decimal(12, 2)
  status        String?   @default("unpaid") // unpaid, paid, void
  paidAt        DateTime?
  method        String?                // bank, easypaisa, jazzcash, cash
  reference     String?
  proof_file_id String?                // StoredFile.id of the college's payment screenshot
  verifyToken   String    @unique      // random, used by the public verify page
  verifiedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([college_id, status])
}

model VerifyToken {
  token      String   @id
  college_id String
  kind       String   // certificate, voucher, receipt, invoice
  ref_id     String
  createdAt  DateTime @default(now())

  @@index([college_id, kind])
  @@index([ref_id])
}

model VerifyLog {
  id          String   @id @default(uuid())
  tokenPrefix String
  ipHash      String
  userAgent   String?
  status      String   // VERIFIED, NOT_FOUND, DISABLED, RATE_LIMITED
  createdAt   DateTime @default(now())

  @@index([tokenPrefix, createdAt])
  @@index([ipHash, createdAt])
}

model PaySlip {
  id            String    @id @default(uuid())
  college_id    String
  employee_id   String
  month         String
  baseSalary    Float
  allowances    Float?    @default(0)
  deductions    Float?    @default(0)
