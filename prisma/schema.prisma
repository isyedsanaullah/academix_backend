// 9F: N05 Institutional Data Backup
model BackupJob {
  id            String    @id @default(uuid())
  college_id    String
  campus_id     String?
  requestedBy   String
  status        String    // QUEUED | RUNNING | READY | FAILED | EXPIRED
  archiveKey    String?   // category BACKUPS (server-exempt)
  manifestKey   String?
  sizeBytes     BigInt    @default(0)
  claimedBy     String?
  heartbeatAt   DateTime?
  expiresAt     DateTime
  failureReason String?
  createdAt     DateTime  @default(now())

  @@index([college_id, createdAt(sort: Desc)])
  @@index([status, heartbeatAt])
}

// 9H: N03 Scheduled Executive Digest
model DigestConfig {
  id         String   @id @default(uuid())
  college_id String   @unique
  campus_id  String?
  isEnabled  Boolean  @default(false)
  recipients String[]
  weekday    Int      // 1-7 (1=Monday ... 7=Sunday)
  sendHour   Int      // 0-23, PKT
  updatedAt  DateTime @updatedAt
}

// 9I: N02 Board-Format Gazette Profiles
model BoardExportProfile {
  id          String   @id @default(uuid())
  boardCode   String   @unique // e.g. BISE_LHR, BISE_FSD, FBISE
  boardName   String
  columnsJson Json
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 9J: N04 Accountant Journal Head Mapping
model AccountHeadMapping {
  id          String   @id @default(uuid())
  college_id  String
  campus_id   String?
  sourceType  String   // FEE_TYPE | PAYMENT_METHOD | FINE | REFUND
  sourceKey   String
  accountName String
  accountCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([college_id, sourceType, sourceKey])
  @@index([college_id])
}

