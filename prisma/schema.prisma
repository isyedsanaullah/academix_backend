  userId       String
  deviceIdHash String
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  lastIp       String?
  userAgent    String?

  @@unique([college_id, userId, deviceIdHash])
  @@index([college_id, userId])
}

// 9B: N01 Export Center
model ExportJob {
  id              String    @id @default(uuid())
  college_id      String
  campus_id       String?
  userId          String
  exportType      String    // STUDENTS | ATTENDANCE | FEES | GAZETTE | LEDGER | AUDIT_LOG
  format          String    // CSV | XLSX | PDF | JSON
  filtersJson     Json?
  periodKey       String    // YYYY-MM
  status          String    // QUEUED | RUNNING | READY | FAILED | EXPIRED
  fileKey         String?   // category EXPORTS (server-exempt)
  rowCount        Int       @default(0)
  sizeBytes       BigInt    @default(0)
  failureReason   String?
  quotaRefundedAt DateTime?
  claimedBy       String?
  heartbeatAt     DateTime?
