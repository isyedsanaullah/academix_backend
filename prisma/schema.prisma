// 11A: Exam Operations & Moderation (N25, N26, N27, N28)

model ExamHall {
  id          String   @id @default(uuid())
  college_id  String
  campus_id   String?
  name        String   // "Jinnah Hall", "Room 102"
  capacity    Int
  rows        Int      // Grid rows
  columns     Int      // Grid columns
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  desks       ExamHallDesk[]
  @@unique([college_id, name])
  @@index([college_id, isActive])
}

model ExamHallDesk {
  id        String   @id @default(uuid())
  hallId    String
  rowNum    Int
  colNum    Int
  deskCode  String   // e.g. "JH-R1-C1"
  hall      ExamHall @relation(fields: [hallId], references: [id], onDelete: Cascade)

  @@unique([hallId, rowNum, colNum])
}

model ExamSeatingPlan {
  id          String   @id @default(uuid())
  college_id  String
  campus_id   String?
  examId      String   // Links to existing Exam model
  name        String   // "Send-up Exam 2026 Seating Master"
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  generatedAt DateTime @default(now())

  seats       ExamAssignedSeat[]
  invigilators ExamInvigilationDuty[]
  @@unique([college_id, examId, name])
}

model ExamAssignedSeat {
  id            String   @id @default(uuid())
  seatingPlanId String
  deskId        String
  student_id    String
  examDate      DateTime @db.Date
  sessionTime   String   // MORNING | EVENING

  seatingPlan   ExamSeatingPlan @relation(fields: [seatingPlanId], references: [id], onDelete: Cascade)
  @@unique([seatingPlanId, deskId, examDate, sessionTime])
  @@unique([seatingPlanId, student_id, examDate, sessionTime])
  @@index([student_id])
}

model ExamInvigilationDuty {
  id            String   @id @default(uuid())
  seatingPlanId String
  teacher_id    String
  hallId        String
  dutyDate      DateTime @db.Date
  sessionTime   String   // MORNING | EVENING
  status        String   @default("ASSIGNED") // ASSIGNED | CONFIRMED | SUBSTITUTED

  seatingPlan   ExamSeatingPlan @relation(fields: [seatingPlanId], references: [id], onDelete: Cascade)
  @@unique([seatingPlanId, teacher_id, dutyDate, sessionTime])
  @@index([teacher_id, dutyDate])
}

model QuestionPaperDraft {
  id            String   @id @default(uuid())
  college_id    String
  campus_id     String?
  examId        String
  subject_id    String
  class         String
  setterId      String   // Teacher userId
  file_id       String   // StoredFile reference (encrypted/confidential)
  status        String   @default("DRAFT") // DRAFT | SUBMITTED | MODERATED | APPROVED | REJECTED | SEALED
  version       Int      @default(1)
  moderatorId   String?  // Head of Department / peer teacher
  moderatorNote String?
  sealedBy      String?  // Principal / Controller of Exams
  sealedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  revisions     QuestionPaperRevision[]
  @@index([college_id, examId, subject_id])
}

model QuestionPaperRevision {
  id           String   @id @default(uuid())
  paperDraftId String
  version      Int
  file_id      String
  uploadedById String
  changeNotes  String?
  createdAt    DateTime @default(now())

  draft        QuestionPaperDraft @relation(fields: [paperDraftId], references: [id], onDelete: Cascade)
  @@unique([paperDraftId, version])
}

model ResultRecheckRequest {
  id              String    @id @default(uuid())
  college_id      String
  campus_id       String?
  student_id      String
  resultId        String    // References existing Result.id
  subject_id      String
  reason          String
  feePaidPkr      Int       @default(500)
  feeVoucherId    String?   // Linked fee challan for re-checking fee
  status          String    @default("SUBMITTED") // SUBMITTED | IN_REVIEW | RESOLVED_UNCHANGED | RESOLVED_CHANGED | REJECTED
  originalMarks   Decimal   @db.Decimal(5, 2)
  revisedMarks    Decimal?  @db.Decimal(5, 2)
  committeeNotes  String?
  reviewedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([college_id, resultId, subject_id])
  @@index([college_id, status])
}

model StudentReportCardRemark {
  id              String   @id @default(uuid())
  college_id      String
  campus_id       String?
  student_id      String
  session_id      String
  examId          String
  classTeacherId  String
  remarks         String   // Qualitative text assessment
  conductRating   String   // EXCELLENT | GOOD | SATISFACTORY | NEEDS_IMPROVEMENT
  punctuality     String   // REGULAR | PUNCTUAL | FREQUENT_ABSENTEE
  boardReadiness  String   // ON_TRACK | AT_RISK | BORDERLINE
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([college_id, student_id, examId])
  @@index([college_id, session_id, examId])
}

// 11B: Student Leave & Multi-Head Clearance (N24, N29)

model ClearanceHead {
  id           String   @id @default(uuid())
  college_id   String
  campus_id    String?
  name         String   // "Accounts Office", "Central Library", "Physics Lab", "Hostel Warden"
  code         String   // ACCOUNTS | LIBRARY | LAB_PHYSICS | LAB_CHEMISTRY | HOSTEL | SPORTS | CANTEEN
  assignedRole String   // accountant | librarian | teacher | employee
  isMandatory  Boolean  @default(true)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  items        StudentClearanceItem[]
  @@unique([college_id, code])
  @@index([college_id, isActive])
}

model StudentClearanceProcess {
  id             String    @id @default(uuid())
  college_id     String
  campus_id      String?
  student_id     String
  session_id     String
  reason         String    // GRADUATED | MIGRATION | WITHDRAWAL | EXPELLED
  destination    String?   // "Transfer to Government College Lahore"
  status         String    @default("IN_PROGRESS") // IN_PROGRESS | CLEARED | REJECTED | CERTIFICATE_ISSUED
  initiatedById  String
  completedAt    DateTime?
  certificateId  String?   @unique
  certificate    LeavingCertificateRecord? @relation(fields: [certificateId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  departmentItems StudentClearanceItem[]
  @@unique([college_id, student_id, session_id])
  @@index([college_id, status])
}

model StudentClearanceItem {
  id            String    @id @default(uuid())
  processId     String
  headId        String
  status        String    @default("PENDING") // PENDING | CLEARED | DUES_OUTSTANDING
  duesAmountPkr Int       @default(0)
  remarks       String?
  clearedById   String?
  clearedAt     DateTime?

  process       StudentClearanceProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  head          ClearanceHead           @relation(fields: [headId], references: [id])
  @@unique([processId, headId])
}

model LeavingCertificateRecord {
  id                 String   @id @default(uuid())
  college_id         String
  campus_id          String?
  student_id         String
  certificateNumber  String   // SLC-YYYY-XXXXX (gap-free sequence)
  characterRating    String   // EXEMPLARY | VERY_GOOD | SATISFACTORY
  conductRemarks     String?
  admissionDate      DateTime @db.Date
  leavingDate        DateTime @db.Date
  reasonForLeaving   String
  qrVerificationHash String   @unique // SHA-256 for public tamper-proof verification
  fileKey            String   // Generated PDF in category REPORTS (server-exempt)
  issuedById         String
  issuedAt           DateTime @default(now())

  process            StudentClearanceProcess?
  @@unique([college_id, certificateNumber])
  @@index([college_id, student_id])
}

// 11C: Teaching Pacing & LMS Knowledge (N23, N30, N31)

model SyllabusBreakdown {
  id           String   @id @default(uuid())
  college_id   String
  campus_id    String?
  session_id   String
  class        String   // "FSc Part 1"
  subject_id   String
  boardName    String   // "BISE Lahore", "Federal Board"
  totalUnits   Int
  totalHours   Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  units        SyllabusUnit[]
  @@unique([college_id, session_id, class, subject_id])
}

model SyllabusUnit {
  id            String   @id @default(uuid())
  breakdownId   String
  unitNumber    Int
  title         String   // "Chapter 2: Vectors and Equilibrium"
  subTopics     String[] // ["Cartesian coordinate system", "Addition of vectors", "Torque"]
  targetWeek    Int      // Academic week number (1 to 32)
  expectedHours Int

  breakdown     SyllabusBreakdown @relation(fields: [breakdownId], references: [id], onDelete: Cascade)
  progress      TeacherSyllabusProgress[]
  @@unique([breakdownId, unitNumber])
}

model TeacherSyllabusProgress {
  id           String    @id @default(uuid())
  college_id   String
  campus_id    String?
  unitId       String
  section_id   String
  teacher_id   String
  status       String    @default("IN_PROGRESS") // NOT_STARTED | IN_PROGRESS | COMPLETED
  completedAt  DateTime?
  actualHours  Int       @default(0)
  notes        String?
  updatedAt    DateTime  @updatedAt

  unit         SyllabusUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  @@unique([college_id, unitId, section_id])
  @@index([college_id, section_id])
}

model LiveClassSchedule {
  id              String   @id @default(uuid())
  college_id      String
  campus_id       String?
  section_id      String
  subject_id      String
  teacher_id      String
  title           String
  platform        String   // GOOGLE_MEET | MS_TEAMS | ZOOM | YOUTUBE_LIVE
  meetingUrl      String   // Validated HTTPS video link
  meetingPassword String?
  scheduledDate   DateTime @db.Date
  startTime       String   // HH:mm
  endTime         String   // HH:mm
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([college_id, section_id, scheduledDate])
}

model DigitalLectureRecording {
  id           String   @id @default(uuid())
  college_id   String
  campus_id    String?
  subject_id   String
  class        String
  unitId       String?  // Linked to SyllabusUnit
  title        String
  description  String?
  videoSource  String   // EMBEDDED_YOUTUBE | VIMEO | EXTERNAL_URL
  videoUrl     String
  durationMins Int?
  uploadedById String
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([college_id, subject_id, class])
}

model ForumQuestion {
  id           String   @id @default(uuid())
  college_id   String
  campus_id    String?
  subject_id   String
  class        String
  student_id   String
  title        String
  body         String
  isPinned     Boolean  @default(false)
  isClosed     Boolean  @default(false)
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  answers      ForumAnswer[]
  @@index([college_id, subject_id, class])
}

model ForumAnswer {
  id           String   @id @default(uuid())
  questionId   String
  authorId     String   // User.id or Student.id
  authorRole   String   // teacher | student
  body         String
  isAccepted   Boolean  @default(false) // Verified/endorsed by teacher
  upvotes      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  question     ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@index([questionId])
}

// 11D: Student Life, Discipline & Alumni (N32, N33, N34)

model DisciplinaryIncident {
  id              String    @id @default(uuid())
  college_id      String
  campus_id       String?
  student_id      String
  session_id      String
  incidentDate    DateTime  @db.Date
  category        String    // MISCONDUCT | FIGHTING | BUNK | CHEATING | DAMAGE | BULLYING | OTHER
  severity        String    // LOW | MEDIUM | HIGH | CRITICAL
  description     String
  actionTaken     String    // WARNING | FINE | SUSPENSION | PARENT_SUMMON | EXPULSION | NONE
  fineAmountPkr   Int?      // Linked to fine voucher if fine imposed
  suspensionDays  Int?
  reportedById    String
  hearingDate     DateTime?
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  counselingNotes StudentCounselingLog[]
  @@index([college_id, student_id])
  @@index([college_id, category, severity])
}

model StudentCounselingLog {
  id           String   @id @default(uuid())
  incidentId   String?
  college_id   String
  campus_id    String?
  student_id   String
  counselorId  String   // Staff userId
  sessionDate  DateTime @db.Date
  sessionNotes String   // Confidential discussion record
  actionPlan   String?
  followUpDate DateTime? @db.Date
  createdAt    DateTime @default(now())

  incident     DisciplinaryIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  @@index([college_id, student_id])
}

model StudentClub {
  id                 String   @id @default(uuid())
  college_id         String
  campus_id          String?
  name               String   // "Literary & Debating Society", "Cricket First XI"
  category           String   // ACADEMIC | SPORTS | CULTURAL | SOCIAL_WORK | LEADERSHIP
  description        String?
  leadTeacherId      String   // Club In-Charge / Coach
  presidentStudentId String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  members            StudentClubMember[]
  events             ClubEvent[]
  @@unique([college_id, name])
}

model StudentClubMember {
  id          String    @id @default(uuid())
  clubId      String
  student_id  String
  role        String    @default("MEMBER") // MEMBER | CAPTAIN | SECRETARY | VICE_PRESIDENT
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  club        StudentClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@unique([clubId, student_id])
  @@index([student_id])
}

model ClubEvent {
  id          String   @id @default(uuid())
  college_id  String
  campus_id   String?
  clubId      String
  title       String   // "Annual Inter-Collegiate Debating Championship 2026"
  eventDate   DateTime @db.Date
  venue       String
  description String?
  budgetPkr   Int      @default(0)

  club        StudentClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  @@index([college_id, eventDate])
}

model AlumniProfile {
  id                  String   @id @default(uuid())
  college_id          String
  campus_id           String?
  student_id          String?  @unique // Nullable link to historical Student record
  fullName            String
  fatherName          String?
  matricRollNumber    String?
  boardRollNumber     String   // Intermediate 2nd year roll number
  passingYear         Int      // 2024, 2025, 2026
  academicGroup       String   // Pre-Medical, Pre-Engineering, ICS
  finalBoardMarks     Int?
  finalBoardTotal     Int?     @default(1100)
  currentStatus       String   // ENROLLED_UNIVERSITY | EMPLOYED | PREPARING | ABROAD
  universityName      String?  // "King Edward Medical University", "NUST Islamabad"
  degreeProgram       String?  // "MBBS", "BS Computer Science"
  email               String?
  phone               String?
  linkedInUrl         String?
  isTestimonialShared Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([college_id, passingYear, academicGroup])
  @@index([college_id, currentStatus])
}

// 11E: Localization & App Capabilities (N09, N21, N22)

model AnnouncementTemplate {
  id                String   @id @default(uuid())
  college_id        String
  campus_id         String?
  title             String   // "Fee Defaulter 2nd Notice", "Rain Emergency Holiday"
  category          String   // FEE_REMINDER | EMERGENCY | EXAM_NOTICE | HOLIDAY | PTM
  bodyTemplate      String   // Contains {{tokens}}
  defaultAudience   String   // ALL | STUDENTS | PARENTS | TEACHERS
  isSystemPreseeded Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

