datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model AdmissionSeason {
  id                String    @id @default(uuid())
  college_id        String
  session_id        String
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime
  availableGroups   String[]
  availableClasses  String[]
  entryTestRequired Boolean?  @default(false)
  entryTestDate     DateTime?
  entryTestVenue    String?
  minAggregate      Float?
  maxSeats          Int?
  status            String?   @default("draft") // draft, open, closed, completed
  instructions      String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([college_id, status])
}

model AIApiKey {
  id           String    @id @default(uuid())
  userId       String
  collegeId    String?
  provider     String    @default("gemini")
  encryptedKey String
  iv           String
  isActive     Boolean?  @default(true)
  lastUsed     DateTime?
  usageCount   Int?      @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([collegeId])
}

model AIUsageLog {
  id           String   @id @default(uuid())
  userId       String
  collegeId    String?
  action       String
  model        String?
  tokensUsed   Int?     @default(0)
  duration     Float?
  success      Boolean? @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([collegeId, action])
  @@index([createdAt(sort: Desc)])
}

model Announcement {
  dispatchedAt      DateTime?
  id            String    @id @default(uuid())
  college_id    String
  title         String
  content       String
  category      String? // Emergency, Holiday, Academic, Examination, Fee, Admission, Event, Administration, General
  audience      String? // All Users, All Students, All Teachers, Parents, Staff, Faculty, Specific Department, Specific Class
  isPublic      Boolean?  @default(false)
  priority      String? // Low, Medium, High, Urgent
  status        String?   @default("Published") // Published, Draft, Scheduled, Archived
  scheduledFor  DateTime?
  expiresAt     DateTime?
  generatedByAI Boolean?  @default(false)
  templateType  String? // Emergency, Examination, Fee, Holiday, Event, General...
  viewCount     Int       @default(0)
  attachments   String[]
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deletedAt         DateTime?
  deletedBy         String?
  deleteReason      String?
  deleteOperationId String?

  @@index([college_id, createdAt(sort: Desc)])
  @@index([college_id, audience])
  @@index([college_id, status])
  @@index([college_id, scheduledFor])
  @@index([college_id, deletedAt])
  @@index([deleteOperationId])
}

model Application {
  id                String    @id @default(uuid())
  college_id        String
  season_id         String
  user_id           String?
  applicationNumber String?   @unique
  name              String
  fatherName        String
  cnic              String?
  dateOfBirth       DateTime
  gender            String
  phone             String
  email             String
  address           String
  city              String?
  guardianName      String?
  guardianPhone     String?
  guardianRelation  String?
  sscBoard          String
  sscYear           Int
  sscRollNumber     String?
  sscTotalMarks     Float
  sscObtainedMarks  Float
  sscAggregate      Float?
  sscResultStatus   String? // declared, awaiting
  preferredClass    String? // FSC Part 1, FSC Part 2
  preferredGroup    String
  photo             String?
  sscDMC            String?
  hopeCertificate   String?
  ninthDMC          String?
  otherDocuments    Json?
  entryTestRequired Boolean?  @default(false)
  entryTestDate     DateTime?
  entryTestVenue    String?
  entryTestScore    Float?
  entryTestStatus   String?   @default("pending") // pending, scheduled, appeared, passed, failed
  status            String?   @default("submitted") // submitted, under_review, entry_test, approved, rejected, enrolled
  rejectionReason   String?
  reviewedBy        String?
  reviewedAt        DateTime?
  remarks           String?
  source            String?   @default("ONLINE") // ONLINE, DESK
  enteredBy         String?
  quota             String?                      // QuotaRule.code
  equivalenceBoard  String?                      // O-level, A-level, other board
  equivalenceMarks  Float?                       // IBCC equivalence percent
  docVerification   Json?                        // { sscDMC: { ok:true, by, at }, cnic: {...}, photo: {...} }
  scholarshipTier_id String?
  meritScore        Float?
  password          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([college_id, season_id, status])
  @@index([college_id, email])
  @@index([applicationNumber])
}

model Approval {
  id                String    @id @default(uuid())
  college_id        String
  type              String
  status            String?   @default("pending") // pending, approved, rejected
  requestedBy       String
  data              Json
  relatedModel      String?
  relatedId         String?
  title             String
  description       String?
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  requiredApprovals Int?      @default(1)
  approvers         Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([college_id, status, type])
  @@index([college_id, createdAt(sort: Desc)])
}

model Assignment {
  id             String   @id @default(uuid())
  college_id     String
  session_id     String
  class_id       String
  section_id     String?
  subject_id     String
  teacher_id     String
  title          String
  description    String?
  instructions   String?
  dueDate        DateTime
  totalMarks     Float?
  submissionType String? // handwritten, typed, both
  attachments    Json?
  submissions    Json?
  status         String?  @default("active") // active, closed, draft
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deletedAt         DateTime?
  deletedBy         String?
  deleteReason      String?
  deleteOperationId String?

  @@index([college_id, session_id, class_id])
  @@index([college_id, teacher_id])
  @@index([college_id, deletedAt])
  @@index([deleteOperationId])
}

model Attendance {
  id         String    @id @default(uuid())
  college_id String
  session_id String
  student_id String
  class      String?
  section    String?
  date       DateTime
  status     String // present, absent, late, leave
  method     String?   @default("manual") // biometric, face, card, qr, manual
  entryTime  DateTime?
  exitTime   DateTime?
  markedBy   String?
  remarks           String?
  correctionReason  String?
  createdAt         DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([college_id, session_id, student_id, date])
  @@index([college_id, session_id, date])
  @@index([college_id, session_id, class, section, date])
}

model AuditLog {
  id         String   @id @default(uuid())
  college_id String?
  user_id    String
  action     String
  resource   String?
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([college_id, createdAt(sort: Desc)])
  @@index([user_id, createdAt(sort: Desc)])
  @@index([action])
}

model StatusOperationLog {
  id             String    @id @default(uuid())
  operationId    String    @unique @default(uuid())
  resourceType   String    // College, Student, User, Class
  resourceId     String
  actorUserId    String
  previousStatus String
  newStatus      String
  college_id     String?   // For tenant scoping
  createdAt      DateTime  @default(now())
  expiresAt      DateTime  // createdAt + 5 seconds (undo window)
  undoneAt       DateTime? // Timestamp when reverted, null if still active

  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([operationId])
  @@index([college_id])
}

model ActivityLog {
  id                 String   @id @default(uuid())
  college_id         String?
  actorUserId        String?
  actorNameSnapshot  String?
  actorRoleSnapshot  String?
  action             String
  category           String
  resourceType       String?
  resourceId         String?
  targetUserId       String?
  title              String?
  description        String?
  status             String?  @default("completed")
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([college_id, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([category])
  @@index([action])
  @@index([resourceType, resourceId])
}


model CanteenTransaction {
  id            String   @id @default(uuid())
  college_id    String
  student_id    String
  items         Json?
  totalAmount   Float
  paymentMethod String? // cash, account, card
  enteredBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([college_id, student_id])
  @@index([college_id, createdAt(sort: Desc)])
}

model Certificate {
  id                   String    @id @default(uuid())
  college_id           String
  student_id           String
  type                 String // character, hope, migration, bonafide
  certificateNumber    String    @unique
  verifyToken          String?   @unique
  templateVersion      Int?      @default(1)
  issueDate            DateTime?
  content              String?
  predictedPerformance String?
  academicConsistency  String?
  basedOn              Json?
  issuedBy             String?
  status               String?   @default("issued") // issued, revoked
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([college_id, student_id])
  @@index([college_id, type])
}

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  collegeId String?
  role      String // student, teacher, principal, admin, registrar, accountant, employee
  title     String?
  messages  Json?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@index([collegeId])
}

model Class {
  id         String   @id @default(uuid())
  college_id String
  campus_id  String?
  session_id String
  name       String // FSC Part 1, FSC Part 2
  groups     String[]
  isActive   Boolean? @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([college_id, session_id, name])
  @@index([college_id, campus_id])
}

model Group {
  id              String                @id @default(uuid())
  college_id      String
  class_id        String // References Class.id (Part)
  name            String // e.g. "Computer Science", "Pre-Medical"
  seats           Int? // @deprecated Phase 8A: use GroupSeatAllocation
  feeNote         String?
  isActive        Boolean?              @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  seatAllocations GroupSeatAllocation[]
  feeSchedules    GroupFeeSchedule[]

  @@unique([college_id, class_id, name])
}

model GroupSeatAllocation {
  id             String   @id @default(uuid())
  college_id     String
  campus_id      String?  // Nullable; Phase 10 campus isolation
  group_id       String
  session_id     String
  maxSeats       Int
  allocatedSeats Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group          Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  session        Session  @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([college_id, group_id, session_id])
  @@index([college_id, session_id])
}

model GroupFeeSchedule {
  id              String   @id @default(uuid())
  college_id      String
  campus_id       String?  // Nullable; Phase 10 campus isolation
  group_id        String
  session_id      String
  tuitionFeePkr   Decimal  @db.Decimal(10, 2)
  admissionFeePkr Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group           Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  session         Session  @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([college_id, group_id, session_id])
  @@index([college_id, session_id])
}

model ClassDiaryEntry {
  id           String                 @id @default(uuid())
  college_id   String
  campus_id    String? // Nullable; Phase 10 campus isolation
  section_id   String
  subject_id   String
  teacher_id   String
  entryDate    DateTime               @db.Date
  periodNumber Int
  topicCovered String
  homework     String?
  remarks      String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  attachments  ClassDiaryAttachment[]

  @@unique([college_id, section_id, subject_id, entryDate, periodNumber])
  @@index([college_id, section_id, entryDate])
  @@index([college_id, teacher_id, entryDate])
}

model ClassDiaryAttachment {
  id             String          @id @default(uuid())
  diary_entry_id String
  college_id     String
  storedFileId   String
  fileName       String
  fileUrl        String
  storageBytes   BigInt          @default(0)
  createdAt      DateTime        @default(now())

  diaryEntry     ClassDiaryEntry @relation(fields: [diary_entry_id], references: [id], onDelete: Cascade)

  @@index([college_id, diary_entry_id])
}

model AcademicCalendarEvent {
  id             String   @id @default(uuid())
  college_id     String
  campus_id      String? // Nullable; Phase 10 campus isolation
  session_id     String
  title          String
  description    String?
  eventType      String   @default("GENERAL") // GENERAL, HOLIDAY, EXAM, EVENT, TERM_START, TERM_END, SPORTS
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  isWorkingDay   Boolean  @default(false)
  targetAudience String   @default("ALL") // ALL, STUDENTS, STAFF, PARENTS
  isPublic       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([college_id, session_id, startDate, endDate])
}

model BulkImportJob {
  id            String          @id @default(uuid())
  college_id    String
  campus_id     String?         // Nullable; Phase 10 campus isolation
  importType    String          // 'students', 'staff', 'fees', 'marks'
  status        String          @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, PARTIAL_SUCCESS
  claimedBy     String?
  heartbeatAt   DateTime?
  totalRows     Int             @default(0)
  rowsProcessed Int             @default(0)
  rowsSuccess   Int             @default(0)
  rowsFailed    Int             @default(0)
  errorCsvUrl   String?
  sourceFileKey String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  rows          BulkImportRow[]

  @@index([college_id, status])
  @@index([status, heartbeatAt])
}

model BulkImportRow {
  id           String        @id @default(uuid())
  job_id       String
  rowNumber    Int
  payloadJson  Json
  status       String        @default("PENDING") // PENDING, SUCCESS, FAILED
  errorMessage String?
  createdAt    DateTime      @default(now())

  job          BulkImportJob @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([job_id, status])
}

model College {
  uploadReservations        UploadReservation[]
  timetableProfiles         TimetableProfile[]
  canteenItems              CanteenItem[]
  cashierShifts             CashierShift[]
  canteenOrders             CanteenOrder[]
  cashDrawerTransactions    CashDrawerTransaction[]
  mealAccounts              StudentMealAccount[]
  mealAccountTransactions   MealAccountTransaction[]
  id               String    @id @default(uuid())
  name             String
  code             String    @unique
  slug             String?   @unique
  status           String?   @default("pending_setup") // pending_setup, onboarding, active, suspended
  onboarding_state Json?     @default("{}")
  activated_at     DateTime?
  tagline          String?
  about            String?
  social_links     Json?
  established_year Int?
  affiliation      String?
  logo_key         String?
  cover_key        String?
  gallery          Json?     @default("[]")
  mongoUrl         String?   @default("")
  email            String    @unique
  phone            String?
  address          String?
  city             String?
  logo             String?   @default("")
  website          String?   @default("")
  subscription     Json?
  settings         Json?
  onboardingStatus String?   @default("completed") // legacy: pending_invite, registered, in_progress, completed
  onboardingStep       Int?                 @default(1)
  totalStudents        Int?                 @default(0)
  totalStaff           Int?                 @default(0)
  isActive             Boolean?             @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  subdomain_verified_at DateTime?           // set when subdomain becomes reachable + welcome email sent
  subscription_status  String?              @default("active") // active, grace, suspended
  grace_until          DateTime?
  feature_overrides    Json?                @default("{}")
  planId               String               @default("starter")
  billingCycle         String               @default("MONTHLY") // MONTHLY, YEARLY
  subStatus            String               @default("TRIAL") // TRIAL, ACTIVE, SUSPENDED
  trialEndsAt          DateTime?
  periodStart          DateTime?
  periodEnd            DateTime?
  annualQuotaCycleStart DateTime?           @default(now())
  forceReadOnly        Boolean              @default(false)
  invites              CollegeInvite[]
  subscriptionPeriods  SubscriptionPeriod[]
  message_deliveries   MessageDelivery[]
  addons               CollegeAddon[]
  subscriptionPayments CollegeSubscriptionPayment[]
  messageLedgerEntries MessageCreditLedgerEntry[]
  aiLedgerEntries      AICreditLedgerEntry[]
  featureOverrides     CollegeFeatureOverride[]

  // Phase 6 fields
  preSuspendStatus         String?  // stores prior subStatus before suspension
  trialExtensionCount      Int      @default(0) // max 2 lifetime extensions
  readOnlyReason           String?  // 'SUBSCRIPTION_EXPIRED' | 'TRIAL_EXPIRED' | null (manual = null)
  tokenEpoch               Int      @default(0) // bumped ONLY on suspend/reactivate/forced revocation
  planVersionId            String?  // FK to PlanVersion.id (pinned until renewal)
  pendingDowngradePlanId   String?  // set on DOWNGRADE approval; applied at renewal
  pendingDowngradeBillingCycle String? // billing cycle for pending downgrade
  planVersion              PlanVersion? @relation(fields: [planVersionId], references: [id])
  quotaOverrides           CollegeQuotaOverride[]
  entitlementAudits        CollegeEntitlementAudit[]

  // Phase 10: Infrastructure, Multi-Campus & Compliance
  ipAllowlistMode          String?  @default("OFF") // OFF | LOG_ONLY | ENFORCE

  @@index([status])
  @@index([subscription(path: "status")])
}

model CollegeInvite {
  id           String    @id @default(uuid())
  college_id   String
  email        String
  token_hash   String    @unique
  expires_at   DateTime
  used_at      DateTime?
  revoked_at   DateTime?
  created_by   String?
  created_at   DateTime  @default(now())
  email_status String    @default("queued") // queued, sent, failed
  email_error  String?
  college      College   @relation(fields: [college_id], references: [id], onDelete: Cascade)

  @@index([college_id])
  @@index([token_hash])
  @@index([expires_at])
}

model SubscriptionPeriod {
  id                  String    @id @default(uuid())
  college_id          String
  plan                String
  features            Json
  starts_at           DateTime
  expires_at          DateTime
  status              String    @default("active") // scheduled, active, expired, cancelled
  amount_note         String?
  payment_note        String?
  created_by          String?
  created_at          DateTime  @default(now())
  reason              String?
  reminded_thresholds String[]  @default([])
  college             College   @relation(fields: [college_id], references: [id], onDelete: Cascade)

  @@index([college_id])
  @@index([status])
}

model MessageDelivery {
  id                String    @id @default(uuid())
  college_id        String
  announcement_id   String?
  recipient_user_id String
  recipient_email   String?
  recipient_role    String?
  subject           String?
  content           String?
  channel           String    // in_app, email
  status            String    @default("queued") // queued, sent, failed
  error             String?
  sent_at           DateTime?
  created_at        DateTime  @default(now())
  college           College   @relation(fields: [college_id], references: [id], onDelete: Cascade)

  @@index([college_id])
  @@index([status])
}

model CollegeInvitation {
  id         String    @id @default(uuid())
  email      String
  planId     String
  token      String    @unique
  status     String    @default("pending") // pending, accepted, expired, cancelled
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  collegeId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([token])
}


model EarlyExitRequest {
  id              String    @id @default(uuid())
  college_id      String
  personType      String // student, teacher, employee
  personId        String
  personName      String?
  qrCode          String?
  reason          String
  exitDate        DateTime
  exitTime        String?
  status          String?   @default("pending") // pending, approved, rejected
  approvedBy      String?
  approvedAt      DateTime?
  approvalRemarks String?
  used            Boolean?  @default(false)
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([college_id, personId, exitDate])
  @@index([college_id, status])
}

model Employee {
  id            String    @id @default(uuid())
  college_id    String
  user_id       String    @unique
  employeeCode  String?
  cnic          String?
  phone         String?
  address       String?
  department    String? // security, canteen, administration, accounts, library, lab, other
  designation   String?
  joiningDate   DateTime?
  salary        Float?
  salaryHistory Json?
  leaveBalance  Json?
  leaveRecords  Json?
  status        String?   @default("active") // active, on-leave, resigned, terminated
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([college_id, department])
}

model EvaluationSeason {
  id          String   @id @default(uuid())
  college_id  String
  title       String
  startDate   DateTime
  endDate     DateTime
  status      String?  @default("announced") // announced, active, completed, cancelled
  announcedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([college_id, status])
}

model Evaluation {
  id          String    @id @default(uuid())
  college_id  String
  season_id   String
  student_id  String
  teacher_id  String
  questions   Json?
  goodCount   Int?      @default(0)
  stars       Float?    @default(0)
  completed   Boolean?  @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([college_id, season_id, student_id, teacher_id])
  @@index([college_id, teacher_id])
}

model Exam {
  id           String   @id @default(uuid())
  college_id   String
  session_id   String
  name         String
  type         String // mid, final, test, practical, send_up
  class        String // FSC Part 1, FSC Part 2, Both
  group        String? // Pre-Medical, Pre-Engineering, Computer Science, all
  section      String?
  subjects     Json?
  seatingPlan  Json?
  invigilation Json?
  status       String?  @default("scheduled") // scheduled, ongoing, completed, cancelled
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([college_id, session_id, class])
  @@index([college_id, session_id, status])
}

model Fee {
  id                   String    @id @default(uuid())
  college_id           String
  session_id           String
  student_id           String
  title                String?
  type                 String?   @default("monthly") // yearly, installment, monthly
  month                String
  tuitionFee           Decimal?  @default(0) @db.Decimal(12, 2)
  functionFee          Decimal?  @default(0) @db.Decimal(12, 2)
  labFee               Decimal?  @default(0) @db.Decimal(12, 2)
  fine                 Decimal?  @default(0) @db.Decimal(12, 2)
  scholarshipDeduction Decimal?  @default(0) @db.Decimal(12, 2)
  canteenDues          Decimal?  @default(0) @db.Decimal(12, 2)
  otherCharges         Decimal?  @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal   @db.Decimal(12, 2)
  paidAmount           Decimal?  @default(0) @db.Decimal(12, 2)
  status               String?   @default("unpaid") // paid, partial, unpaid, overdue
  paidDate             DateTime?
  receiptNumber        String?
  challanNumber        String?
  verifyToken          String?   @unique
  dueDate              DateTime?
  enteredBy            String?
  remarks              String?
