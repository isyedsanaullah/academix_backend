  college_id      String
  student_id      String
  type            String   // PURCHASE, TOPUP, REFUND
  amountPkr       Int
  balanceAfterPkr Int
  order_id        String?
  cashierId       String
  notes           String?
  createdAt       DateTime @default(now())

  college         College  @relation(fields: [college_id], references: [id], onDelete: Cascade)

  @@index([college_id, student_id, createdAt])
}

model StaffAttendance {
