  @@index([college_id, session_id, date])
  @@index([college_id, session_id, subject_id])
}

model PracticalMark {
  id          String   @id @default(uuid())
  college_id  String
  session_id  String
  student_id  String
  subject_id  String
  exam_id     String?                  // Exam with type 'practical'
  practical_id String?                 // PracticalSession.id
  marks       Float?
  maxMarks    Float?
  journalMarks Float?
  attended    Boolean? @default(true)  // lab attendance
  enteredBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([college_id, session_id, student_id, subject_id, exam_id])
  @@index([college_id, session_id, subject_id])
}

model LabJournal {
  id           String   @id @default(uuid())
  college_id   String
  session_id   String
  student_id   String
  subject_id   String
  required     Int?     @default(0)
  submitted    Int?     @default(0)
  checked      Int?     @default(0)
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([college_id, session_id, student_id, subject_id])
}

model LabStockItem {
  id          String    @id @default(uuid())
  college_id  String
  name        String
  category    String                  // apparatus, chemical, consumable, equipment
  subject     String?                 // Physics, Chemistry, Biology, Computer
  unit        String?
  quantity    Float     @default(0)
  minQuantity Float?    @default(0)
  location    String?
  expiryDate  DateTime?
  isActive    Boolean?  @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([college_id, category])
}

model LabStockMovement {
  id         String   @id @default(uuid())
  college_id String
  item_id    String
  change     Float                     // + purchase, - use or breakage
  reason     String                    // purchase, practical, breakage, expiry, adjustment
  practical_id String?
  enteredBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([college_id, item_id, createdAt(sort: Desc)])
}

model BoardPracticalExaminer {
  id          String   @id @default(uuid())
  college_id  String
  session_id  String
  board       String
  subject_id  String?
  centreName  String?
  examDate    DateTime?
  examinerName String
  examinerCnic String?
  examinerType String  @default("external") // internal, external
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([college_id, session_id, board])
}

// ---- Admissions: quotas, equivalence, per-document verification ----
model QuotaRule {
  id           String   @id @default(uuid())
  college_id   String
  session_id   String
  code         String                  // hafiz-e-quran, sports, sibling, staff-child, orphan, disabled, other
  name         String
  seats        Int?
  seatsPercent Float?
  discountType String?  @default("none") // none, percent, fixed
  discountValue Decimal? @default(0) @db.Decimal(12, 2)
  isActive     Boolean? @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([college_id, session_id, code])
}

model ScholarshipTier {                // scholarship by matric marks
  id           String   @id @default(uuid())
  college_id   String
  session_id   String
  name         String                  // "A+ merit"
  minPercent   Float
  maxPercent   Float?
  discountType String   @default("percent") // percent, fixed
  discountValue Decimal @default(0) @db.Decimal(12, 2)
  appliesTo    String[]                // fee types, e.g. ["tuition"]
  isActive     Boolean? @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([college_id, session_id])
}

model EnquiryLead {
  id             String    @id @default(uuid())
  college_id     String
  session_id     String?
  name           String
  phone          String
  source         String?             // walk-in, call, facebook, whatsapp, referral
  preferredGroup String?
  status         String?   @default("new") // new, contacted, test_scheduled, applied, enrolled, lost
  testDate       DateTime?
  followUps      Json?
  assignedTo     String?
  application_id String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([college_id, status])
}

// ---- Fees ----
model FeeStructure {                   // fee types per group; Fee rows are generated from these
  id             String   @id @default(uuid())
  college_id     String
  session_id     String
  group_id       String?             // null = all groups
  class          String?             // FSC Part 1, FSC Part 2, Both
  feeType        String              // admission, annual, tuition, lab, board, security, library, other
  amount         Decimal  @db.Decimal(12, 2)
  dueDate        DateTime?
  installments   Json?               // [{ no:1, percent:50, dueDate }]
  lateFeePerDay  Decimal? @default(0) @db.Decimal(12, 2)
  lateFeeCap     Decimal? @db.Decimal(12, 2)
  isActive       Boolean? @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([college_id, session_id, group_id])
}

model FeeRefund {
  id         String   @id @default(uuid())
  college_id String
  student_id String
  fee_id     String?
  payment_id String?
  amount     Decimal  @db.Decimal(12, 2)
  reason     String
  status     String?  @default("pending") // pending, approved, paid, rejected
  approval_id String?                // Approval.id
  decidedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([college_id, student_id])
}

// ---- Entry-test preparation (Phase 10) ----
model McqQuestion {
  id          String   @id @default(uuid())
  college_id  String
  subject     String                    // Physics, Chemistry, Biology, Mathematics, English, Logical Reasoning
  class       String?                   // FSC Part 1, FSC Part 2
  chapter     String?
  topic       String?
  text        String
  options     Json                      // ["A ...", "B ...", "C ...", "D ..."]
  answerIndex Int
  explanation String?
  difficulty  String?  @default("medium") // easy, medium, hard
  tags        String[]                  // mdcat, ecat, nust
  source      String   @default("manual") // manual, import, ai
  isActive    Boolean? @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([college_id, subject, chapter])
}

model MockTest {
  id            String   @id @default(uuid())
  college_id    String
  session_id    String
  title         String
  series        String?              // "MDCAT Series 2026"
  tag           String               // mdcat, ecat
  testDate      DateTime?
  questionIds   String[]
  totalMarks    Float?
  negativeMark  Float?   @default(0)
  markingMode   String   @default("manual") // online, manual, omr
  answerKey     Json?                // used by manual and omr marking
  status        String?  @default("draft") // draft, scheduled, done
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([college_id, session_id, tag])
}

model MockAttempt {
  id          String   @id @default(uuid())
  college_id  String
  session_id  String
  mock_id     String
  student_id  String
  answers     Json?
  score       Float?
  correct     Int?
  wrong       Int?
  skipped     Int?
  rankSection Int?
  rankCollege Int?
  source      String   @default("manual") // online, manual, omr
  file_id     String?                // scanned OMR sheet
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([college_id, mock_id, student_id])
  @@index([college_id, session_id, student_id])
}

model AggregateFormula {
  id         String   @id @default(uuid())
  college_id String
  name       String                    // "UHS MBBS 2026"
  program    String                    // mbbs, bds, engineering, cs
  weights    Json                      // { matric: 10, fsc: 40, entryTest: 50 }
  year       Int?
  isActive   Boolean? @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([college_id, program])
}

model EntryTestRegistration {
  id             String   @id @default(uuid())
  college_id     String
  session_id     String
  student_id     String
  testName       String                  // MDCAT, ECAT, NUST NET
  registrationNo String?
  testDate       DateTime?
  score          Float?
  status         String?  @default("planned") // planned, registered, appeared, result_out
  applications   Json?                   // [{ university, program, status, deadline }]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([college_id, session_id, student_id])
}

// ---- Parents, guidance (Phase 10) ----
model ParentMeeting {
  id          String   @id @default(uuid())
  college_id  String
  session_id  String
  title       String
  exam_id     String?                   // the test it follows
  meetingDate DateTime
  sectionIds  String[]
  notes       Json?                     // [{ student_id, attended, note }]
  status      String?  @default("scheduled") // scheduled, done, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([college_id, session_id, meetingDate])
}

model CareerCounselling {
  id          String   @id @default(uuid())
  college_id  String
  student_id  String
  sessionDate DateTime
  counsellor  String?
  interests   String[]
  plan        String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([college_id, student_id])
}

model ScholarshipRecord {
  id          String   @id @default(uuid())
  college_id  String
  student_id  String
  scheme      String                    // PEEF, HEC, Punjab Endowment, college
  provider    String?
  amount      Decimal? @db.Decimal(12, 2)
  status      String?  @default("applied") // applied, awarded, rejected, renewal_due, closed
  renewalDate DateTime?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([college_id, student_id])
  @@index([college_id, status])
}

model StudentFeedback {
  id         String   @id @default(uuid())
  college_id String
  student_id String?                   // null when anonymous
  category   String                    // academic, facilities, discipline, staff, other
  message    String
  anonymous  Boolean? @default(false)
  status     String?  @default("open") // open, in_review, resolved, closed
  handledBy  String?
  response   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([college_id, status])
}

