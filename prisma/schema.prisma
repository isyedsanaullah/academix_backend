// 9C: N10 Custom Roles & Permissions
model CustomRole {
  id           String           @id @default(uuid())
  college_id   String
  campus_id    String?
  name         String
  description  String?
  permissions  String[]         // validated against catalog
  isAdminClass Boolean          @default(false)
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignments  UserCustomRole[]

  @@unique([college_id, name])
  @@unique([id, college_id])
}

model UserCustomRole {
  id         String     @id @default(uuid())
  college_id String
  campus_id  String?
  userId     String
  roleId     String
  assignedBy String
  assignedAt DateTime   @default(now())
  role       CustomRole @relation(fields: [roleId, college_id], references: [id, college_id], onDelete: Cascade)

  @@unique([college_id, userId, roleId])
  @@index([college_id, userId])
}

// 9D: N11 Multi-Step Approval Workflows
model ApprovalChain {
  id           String              @id @default(uuid())
  college_id   String
  campus_id    String?
  workflowType String              // FEE_CONCESSION | FEE_REFUND | STAFF_LEAVE | MARKS_EDIT | PURCHASE_ORDER
  isActive     Boolean             @default(true)
  steps        ApprovalChainStep[]

  @@unique([college_id, workflowType])
}

model ApprovalChainStep {
  id           String        @id @default(uuid())
  chainId      String
  stepNumber   Int
  approverType String        // ROLE | USER | CUSTOM_ROLE
  approverRef  String        // role name, userId or customRoleId
  chain        ApprovalChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@unique([chainId, stepNumber])
}

model ApprovalRequest {
  id           String                @id @default(uuid())
  college_id   String
  campus_id    String?
  workflowType String
  requesterId  String
  currentStep  Int                   @default(1)
  totalSteps   Int
  status       String                // PENDING | APPROVED | REJECTED | CANCELLED
  payloadJson  Json
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  steps        ApprovalRequestStep[]
  actions      ApprovalAction[]

  @@index([college_id, workflowType, status])
  @@index([college_id, requesterId])
}

model ApprovalRequestStep {
  id           String          @id @default(uuid())
  requestId    String
  college_id   String
  campus_id    String?
  stepNumber   Int
  approverType String
  approverRef  String
  request      ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepNumber])
}

model ApprovalAction {
  id         String          @id @default(uuid())
  requestId  String
  college_id String
  campus_id  String?
  stepNumber Int
  actorId    String
  action     String          // APPROVED | REJECTED | CANCELLED
  note       String?
  actedAt    DateTime        @default(now())
  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepNumber, action])
}

