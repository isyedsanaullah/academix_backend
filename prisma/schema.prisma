model TokenCostSample {
  id             String   @id @default(uuid())
  college_id     String
  featureKey     String   // 'ai-tutor-chat', 'document-ocr', 'ask-your-data'
  modelName      String   // 'gemini-1.5-flash', 'gemini-1.5-pro'
  promptTokens   Int
  outputTokens   Int
  creditsDebited Int
  latencyMs      Int
  createdAt      DateTime @default(now())

  @@index([featureKey, createdAt(sort: Desc)])
  @@index([college_id, featureKey])
}



model KnowledgeBook {
  id          String   @id @default(uuid())
  college_id  String?  // NULL = platform shared textbook; Non-null = college custom notes
  subject_id  String
  class       String   // "FSc Part 1"
  title       String   // "Physics Part 1 - Punjab Curriculum"
  fileKey     String   // Stored in R2 (server-exempt)
  status      String   @default("INDEXED") // PENDING | INDEXING | INDEXED | FAILED
  totalChunks Int      @default(0)
  createdAt   DateTime @default(now())

  chunks      DocumentChunkVector[]
  @@index([subject_id, class])
  @@index([college_id])
}

model DocumentChunkVector {
  id          String   @id @default(uuid())
  bookId      String
  chunkIndex  Int
  chapterName String?
  pageNumber  Int
  chunkText   String
  embedding   Unsupported("vector(768)")?

  book        KnowledgeBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  @@index([bookId, pageNumber])
}

model PendingAgentAction {
  id           String    @id @default(uuid())
  college_id   String
  campus_id    String?
  actionType   String   // 'FEE_REMINDER_BROADCAST' | 'TEACHER_SUBSTITUTION' | 'ATTENDANCE_ANOMALY' | 'DEFENDER_SUMMON'
  title        String
  description  String
  payloadJson  Json
  status       String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | EXECUTED | DISMISSED
  executedById String?
  executedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([college_id, status])
  @@index([college_id, actionType])
}

model StudentTutorDailyUsage {
  id            String   @id @default(uuid())
  college_id    String
  student_id    String
  usageDate     String   // "YYYY-MM-DD"
  messageCount  Int      @default(0)
  lastMessageAt DateTime @default(now())

  @@unique([college_id, student_id, usageDate])
  @@index([college_id, usageDate])
}

model WeakTopicAnalysis {
  id           String   @id @default(uuid())
  college_id   String
  campus_id    String?
  subjectId    String
  class        String
  sectionId    String?
  unitName     String
  averageScore Float
  masteryLevel String   // RED (<50%) | YELLOW (50-75%) | GREEN (>75%)
  diagnosedAt  DateTime @default(now())

  @@index([college_id, subjectId, class])
}

model StudentStudyPlan {
  id          String   @id @default(uuid())
  college_id  String
  student_id  String
  title       String
  targetExam  String   // "BISE Final 2027", "MDCAT"
  planJson    Json
  createdAt   DateTime @default(now())

  @@index([college_id, student_id])
}








