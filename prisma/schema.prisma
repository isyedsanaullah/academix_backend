model SubscriptionReminderLog {
  id            String   @id @default(uuid())
  college_id    String
  eventType     String   // RENEWAL_30D, RENEWAL_14D, RENEWAL_7D, RENEWAL_1D, TRIAL_3D, TRIAL_1D, GRANDFATHER_90D, GRANDFATHER_60D, GRANDFATHER_30D, GRANDFATHER_14D, EXPIRY_TRANSITION
  sentDate      DateTime @db.Date // Calendar date YYYY-MM-DD in PKT
  periodEndDate DateTime @db.Date // Period end date for renewal / grandfather deadline for GF / trial end
  createdAt     DateTime @default(now())

  @@unique([college_id, eventType, periodEndDate])
  @@index([college_id])
}

model UsedStepUpToken {
