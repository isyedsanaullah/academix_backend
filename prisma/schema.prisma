/// Central file metadata for all R2-managed uploads.
/// Every file uploaded through the application gets a record here.
/// The R2 object key is stored here — presigned URLs are generated on demand.
model StoredFile {
  id               String    @id @default(uuid())
  college_id       String                              // owning tenant
  uploadedById     String                              // authenticated uploader user ID
  objectKey        String    @unique                   // R2 object key (e.g. tenants/{id}/...)
  originalFilename String                              // sanitized display name
  contentType      String                              // verified MIME type
  sizeBytes        Int                                 // verified file size
  checksumSha256   String?                             // optional integrity checksum
  category         String    @default("general")       // image, document, pdf, attachment, etc.
  entityType       String?                             // Student, Assignment, Announcement, etc.
  entityId         String?                             // associated record ID
  status           String    @default("pending")       // pending, uploading, ready, quarantined, failed, deleting, deleted
  errorMessage     String?                             // reason for failure/quarantine
  migratedFrom     String?                             // legacy reference for migration tracking
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([college_id, status])
  @@index([college_id, entityType, entityId])
  @@index([college_id, category])
  @@index([college_id, createdAt(sort: Desc)])
  @@index([status, createdAt])                         // for cleanup jobs
  @@index([uploadedById])
}

// ======================= PART A: platform =======================

model FeatureFlag {                    // release stage and kill switch only; the catalog itself stays in code
  key          String   @id           // "board-registration"
  release      String   @default("HIDDEN")   // HIDDEN, BETA, GA, DEPRECATED
  killSwitch   Boolean  @default(false)
  betaColleges String[]
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CollegeUsage {                   // atomic quota counters (see services/quota.js in the entitlement document)
  id         String   @id @default(uuid())
  college_id String
  metric     String                    // students, staff, storageBytes, applications, aiTokens, smsCredits, waCredits
  period     String   @default("total") // total, 2026, 2026-10
  value      BigInt   @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([college_id, metric, period])
}

model CollegeEntitlementAudit {
  id              String   @id @default(uuid())
  college_id      String
  actorUserId     String
  actorEmail      String?
  action          String   // QUOTA_OVERRIDE, FEATURE_OVERRIDE, SUSPEND, REACTIVATE, EXTEND_TRIAL, CREDIT_ADJUSTMENT, SETTLEMENT_APPROVE, SETTLEMENT_REJECT, RENEWAL_OVERCAP_WARNING, DOWNGRADE_DEFER, CLEAR_READONLY
  featureKey      String?
  beforeStateJson Json?    // migrated from previousVal String? via raw SQL
  afterStateJson  Json?    // migrated from newVal String? via raw SQL
  previousVal     String?  // preserved for backwards compatibility
  newVal          String?  // preserved for backwards compatibility
  reason          String?
  paymentId       String?
  ipAddress       String?
  createdAt       DateTime @default(now())

  // onDelete: Restrict � block college hard-delete if audit rows exist; use College.deletedAt soft-delete
  college         College  @relation(fields: [college_id], references: [id], onDelete: Restrict)

  // Immutability enforced by DB trigger (prevent_audit_mutation) applied in raw SQL migration
  @@index([college_id, createdAt(sort: Desc)])
  @@index([featureKey])
  @@index([paymentId])
}

model FallbackEvent {                  // how often Plan B was used; drives the usage page and upgrade prompts
  id         String   @id @default(uuid())
  college_id String
  capability String                    // student.identify, attendance.mark ...
  method     String                    // search, manual, print ...
  userId     String?
  role       String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([college_id, capability, createdAt(sort: Desc)])
}

// ======================= PART B: tenant tables (Phase 5) =======================

