  campus_id  String?
  userId     String?
  ip         String
  path       String
  mode       String   // LOG_ONLY | ENFORCE
  dayKey     String   // YYYY-MM-DD
  createdAt  DateTime @default(now())

  @@unique([college_id, userId, ip, dayKey])
  @@index([college_id, createdAt(sort: Desc)])
}

// 10C: N16 Data Retention Policies & Legal Hold (Enterprise)
model LegalHold {
  id            String    @id @default(uuid())
  college_id    String
  campus_id     String?   // Pre-wired for campus-specific legal inquiries
  title         String
  reason        String
  scopeType     String    // ALL_STUDENTS | SESSION | STUDENT
  targetId      String?
  placedBy      String
  isActive      Boolean   @default(true)
  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?
  createdAt     DateTime  @default(now())

  @@index([college_id, isActive])
}

model RetentionPolicy {
  id         String   @id @default(uuid())
  college_id String
  campus_id  String?
  entityType String   // TRASHED_STUDENT | STORED_FILE
  retainDays Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([college_id, entityType])
}

// 10E / 10F: §10.1 & N18 Campus Model (Option B)
model Campus {
  id         String   @id @default(uuid())
  college_id String
  name       String
  code       String
  address    String?
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([college_id, code])
  @@index([college_id, isActive])
}

// 10G: N19 Inter-Campus Student Transfer Management (Enterprise)
model StudentCampusTransfer {
  id            String   @id @default(uuid())
  college_id    String
  student_id    String
  fromSectionId String
  toSectionId   String
  fromCampusId  String
  toCampusId    String
  reason        String?
  transferredBy String
  createdAt     DateTime @default(now())

  @@index([college_id, student_id])
}

