  // Phase 6A additive fields
  verifiedAmount       Int?     // settled PKR (may differ from amountPaid after Super Admin override)
  receiptNumber        String?  @unique // RCP-YYYY-XXXXX sequential, gap-free
  taxAmountPkr         Int?     // populated only if OD-01 -> formal GST invoice
  isDuplicateSuspected Boolean  @default(false) // fuzzy duplicate flag (cross-method or amount+date match)

  college   College   @relation(fields: [college_id], references: [id], onDelete: Cascade)

  // NOTE: @@unique([paymentMethod, transactionId]) removed � replaced by partial unique index
  // applied as raw SQL migration (see migration script) to exclude REJECTED and CANCELLED rows.
  // Remove the @@unique from here so prisma migrate does not recreate it.
  @@index([college_id, status])
  @@index([status])
  @@index([isDuplicateSuspected])
}

