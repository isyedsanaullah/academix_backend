// 12A: N35 Library Management Module (Premium / Add-on on Standard)
model BookTitle {
  id          String   @id @default(uuid())
  college_id  String
  campus_id   String?
  isbn        String?
  title       String
  author      String
  edition     String?
  publisher   String?
  category    String   // SCIENCES | LITERATURE | ISLAMIC | REFERENCE | TEXTBOOK
  ddcClass    String?  // Dewey Decimal Classification
  totalCopies Int      @default(1)
  createdAt   DateTime @default(now())

  copies      BookCopy[]
  @@unique([college_id, title, author, edition])
  @@index([college_id, category])
}

model BookCopy {
  id              String    @id @default(uuid())
  titleId         String
  accessionNumber String
  barcode         String
  condition       String    @default("GOOD") // NEW | GOOD | WORN | DAMAGED | LOST
  status          String    @default("AVAILABLE") // AVAILABLE | ISSUED | RESERVED | IN_REPAIR
  addedAt         DateTime  @default(now())

  title           BookTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  issues          BookIssueRecord[]
  @@unique([titleId, accessionNumber])
  @@unique([titleId, barcode])
}

model BookIssueRecord {
  id            String    @id @default(uuid())
  college_id    String
  campus_id     String?
  copyId        String
  student_id    String?   // Issued to student OR staff
  userId        String?
  borrowerType  String    // STUDENT | STAFF
  issuedAt      DateTime  @default(now())
  dueDate       DateTime  @db.Date
  returnedAt    DateTime?
  fineAmountPkr Int       @default(0)
  fineStatus    String    @default("NONE") // NONE | PENDING | PAID | WAIVED
  issuedById    String

  copy          BookCopy  @relation(fields: [copyId], references: [id])
  @@index([college_id, student_id, returnedAt])
  @@index([college_id, dueDate, returnedAt])
}

// 12B: N36 Transport Management Module (Enterprise / Add-on on Standard & Premium)
model TransportRoute {
  id             String   @id @default(uuid())
  college_id     String
  campus_id      String?
  routeNumber    String   // "Route 4", "Gulberg Express"
  description    String?
  monthlyFarePkr Int
  isActive       Boolean  @default(true)

  stops          TransportStop[]
  vehicles       TransportVehicle[]
  allocations    StudentTransportAllocation[]
  @@unique([college_id, routeNumber])
}

model TransportStop {
  id          String   @id @default(uuid())
  routeId     String
  stopName    String   // "Kalma Chowk", "Main Market"
  pickupTime  String   // "07:15"
  dropTime    String   // "14:15"
  stopOrder   Int

  route       TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  @@unique([routeId, stopOrder])
}

model TransportVehicle {
  id                 String   @id @default(uuid())
  routeId            String?
  college_id         String
  campus_id          String?
  registrationNo     String   // "LEA-2024-890"
  seatCapacity       Int
  driverName         String
  driverPhone        String
  conductorName      String?
  fitnessCertExpires DateTime? @db.Date
  isActive           Boolean  @default(true)

  route              TransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  @@unique([college_id, registrationNo])
}

model StudentTransportAllocation {
  id          String    @id @default(uuid())
  college_id  String
  campus_id   String?
  student_id  String
  session_id  String
  routeId     String
  stopId      String
  allocatedAt DateTime  @default(now())
  isActive    Boolean   @default(true)

  route       TransportRoute @relation(fields: [routeId], references: [id])
  @@index([college_id, student_id, session_id, isActive])
  @@index([routeId, isActive])
}

// 12C: N37 Hostel Management Module (Enterprise / Add-on on Standard & Premium)
model HostelBuilding {
  id          String   @id @default(uuid())
  college_id  String
  campus_id   String?
  name        String   // "Iqbal Hall (Boys)", "Fatima Jinnah Hall (Girls)"
  gender      String   // MALE | FEMALE
  wardenId    String   // Staff userId
  totalRooms  Int
  isActive    Boolean  @default(true)

  rooms       HostelRoom[]
  @@unique([college_id, name])
}

model HostelRoom {
  id             String   @id @default(uuid())
  buildingId     String
  roomNumber     String   // "101", "204"
  capacity       Int      @default(3) // Bed count
  monthlyRentPkr Int
  isActive       Boolean  @default(true)

  building       HostelBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  allotments     StudentHostelAllotment[]
  @@unique([buildingId, roomNumber])
}

model StudentHostelAllotment {
  id          String    @id @default(uuid())
  college_id  String
  campus_id   String?
  student_id  String
  session_id  String
  roomId      String
  bedNumber   Int
  allottedAt  DateTime  @default(now())
  vacatedAt   DateTime?
  isActive    Boolean   @default(true)

  room        HostelRoom @relation(fields: [roomId], references: [id])
  @@index([roomId, bedNumber, isActive])
  @@index([college_id, student_id, session_id, isActive])
}

model HostelNightAttendance {
  id          String   @id @default(uuid())
  college_id  String
  buildingId  String
  student_id  String
  date        DateTime @db.Date
  status      String   // PRESENT | ABSENT | HOME_PASS | NIGHT_OUT
  markedById  String
  remarks     String?
  createdAt   DateTime @default(now())

  @@unique([college_id, student_id, date])
  @@index([buildingId, date, status])
}

// 12D: N38 Inventory & Fixed Asset Register (Premium Tier)
model FixedAsset {
  id               String    @id @default(uuid())
  college_id       String
  campus_id        String?
  assetCode        String    // "AST-COMP-0042", "AST-GEN-01"
  name             String
  category         String    // COMPUTERS | LAB_EQUIPMENT | FURNITURE | VEHICLES | ELECTRICAL | HVAC
  location         String    // "Computer Lab 2", "Chemistry Lab"
  purchaseDate     DateTime  @db.Date
  purchaseCostPkr  Int
  salvageValuePkr  Int       @default(0)
  usefulLifeYears  Int       @default(5)
  currentValuePkr  Int
  depreciationRate Float    // e.g. 20.0%
  status           String    @default("IN_USE") // IN_USE | UNDER_REPAIR | WRITTEN_OFF | SOLD
  serialNumber     String?
  vendorId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  maintenanceLogs  AssetMaintenanceLog[]
  @@unique([college_id, assetCode])
  @@index([college_id, category, status])
}

model AssetMaintenanceLog {
  id          String   @id @default(uuid())
  assetId     String
  college_id  String
  serviceDate DateTime @db.Date
  costPkr     Int      @default(0)
  description String
  servicedBy  String   // Vendor or in-house technician
  createdAt   DateTime @default(now())

  asset       FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([assetId, serviceDate])
}

// 12E: N39 Purchase Requests & Vendor Accounts Payable (Premium Tier)
model Vendor {
  id            String   @id @default(uuid())
  college_id    String
  name          String   // "Crown Scientific Supplies Lahore"
  contactPerson String?
  phone         String
  ntnNumber     String?
  bankName      String?
  iban          String?
  balancePkr    Int      @default(0) // Accounts payable balance
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  @@unique([college_id, name])
}

model PurchaseOrder {
  id              String    @id @default(uuid())
  college_id      String
  campus_id       String?
  poNumber        String    // PO-YYYY-XXXXX
  vendorId        String
  status          String    @default("DRAFT") // DRAFT | APPROVED | ISSUED | RECEIVED | BILLED | CANCELLED
  totalAmountPkr  Int
  orderDate       DateTime  @db.Date
  deliveryDueDate DateTime? @db.Date
  createdById     String
  approvedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor          Vendor    @relation(fields: [vendorId], references: [id])
  items           PurchaseOrderItem[]
  @@unique([college_id, poNumber])
}

model PurchaseOrderItem {
  id           String @id @default(uuid())
  poId         String
  description  String // "Microscope Glass Slides (Box of 100)"
  quantity     Int
  unitPricePkr Int
  totalPricePkr Int

  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
}

// 12F: N40 Double-Entry Accounting & General Ledger (Enterprise Tier)
model AccountHead {
  id           String   @id @default(uuid())
  college_id   String
  code         String   // "1010", "4010"
  name         String   // "Cash in Hand", "Tuition Fee Revenue"
  accountType  String   // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  parentCode   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  journalLines JournalLineItem[]
  @@unique([college_id, code])
  @@index([college_id, accountType])
}

model JournalVoucher {
  id          String   @id @default(uuid())
  college_id  String
  campus_id   String?
  voucherNo   String   // JV-YYYY-XXXXX
  voucherType String   // JV (Journal) | PV (Payment) | RV (Receipt)
  voucherDate DateTime @db.Date
  narration   String
  status      String   @default("POSTED") // POSTED | VOIDED
  createdById String
  createdAt   DateTime @default(now())

  lines       JournalLineItem[]
  @@unique([college_id, voucherNo])
  @@index([college_id, voucherDate])
}

model JournalLineItem {
  id          String   @id @default(uuid())
  voucherId   String
  accountCode String
  college_id  String
  debitPkr    Int      @default(0)
  creditPkr   Int      @default(0)
  narration   String?

  voucher     JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account     AccountHead    @relation(fields: [college_id, accountCode], references: [college_id, code])
  @@index([college_id, accountCode])
}

// 12G: N41 Departmental Budgets & Cost Centres (Enterprise Tier)
model DepartmentBudget {
  id            String   @id @default(uuid())
  college_id    String
  campus_id     String?  // Absorbs N18 multi-campus budget allocation
  fiscalYear    String   // "2026-2027"
  department    String   // "Physics Dept", "Sports Dept", "Admin & IT"
  allocatedPkr  Int
  consumedPkr   Int      @default(0)
  blockedPkr    Int      @default(0) // Committed in pending POs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  allocations   BudgetExpenseCommitment[]
  @@index([college_id, fiscalYear, department])
  @@index([college_id, fiscalYear])
}

model BudgetExpenseCommitment {
  id            String   @id @default(uuid())
  budgetId      String
  referenceType String   // PURCHASE_ORDER | REIMBURSEMENT
  referenceId   String
  amountPkr     Int
  status        String   // COMMITTED | SETTLED | RELEASED
  createdAt     DateTime @default(now())

  budget        DepartmentBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  @@index([budgetId, status])
}

