# ─── Academix Backend Production Environment Variables ───
PORT=5000
NODE_ENV=production

# ─── Database (Neon Serverless PostgreSQL) ───
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://your_user:your_password@ep-your-endpoint.neon.tech/neondb?sslmode=require"

# (Optional) Direct URL for Prisma migrations if using Neon Connection Pooler
# DIRECT_URL="postgresql://your_user:your_password@ep-your-endpoint.neon.tech/neondb?sslmode=require"

# ─── Security & Authentication ───
JWT_SECRET=generate_a_strong_random_secret_here_for_production_2026
JWT_EXPIRE=7d
ENCRYPTION_SECRET=32_character_long_secret_for_data_encryption_here

# ─── CORS & Client Origin ───
# Comma-separated list of allowed frontend URLs (e.g. your Vercel domain)
CLIENT_URL=https://your-frontend-app.vercel.app

# ─── Storage & Uploads ───
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ─── Optional: Cloud Object Storage (Supabase Storage) ───
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_key
# SUPABASE_BUCKET=pdf-documents

# ─── Email Service ───
# Options: gmail | smtp | resend | sendgrid
EMAIL_PROVIDER=gmail
EMAIL_FROM_NAME=Academix
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── AI Providers (Optional for AI Tools) ───
# GEMINI_API_KEY=your_gemini_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
